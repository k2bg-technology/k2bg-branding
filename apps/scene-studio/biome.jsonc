{
  "root": false,
  "extends": ["biome-config/biome.jsonc"],
  "plugins": ["../../packages/biome-config/plugins/noLet.grit"],

  "files": {
    "includes": [
      "src/**/*.{ts,tsx}",
      "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc}"
    ]
  },

  "overrides": [
    {
      "includes": ["*.config.*", "*.d.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ]
}
