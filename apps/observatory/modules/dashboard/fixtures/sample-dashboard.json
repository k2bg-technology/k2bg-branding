{
  "id": "sample-dashboard",
  "title": "Sample dashboard",
  "description": "A fixture for the dashboard walking skeleton.",
  "grain": "month",
  "timeZone": "Asia/Tokyo",
  "locale": "ja-JP",
  "defaultPeriod": "last-complete",
  "labels": {
    "period": "Review month",
    "previousPeriod": "Earlier month",
    "nextPeriod": "Later month",
    "previousPage": "Earlier page",
    "nextPage": "Later page",
    "pagination": "Entry pages",
    "nullCategory": "No category"
  },
  "currency": "JPY",
  "revalidate": 86400,
  "sections": [
    {
      "id": "monthly-summary",
      "title": "Monthly summary",
      "kind": "stat-tiles",
      "source": {
        "dataset": "sample_dataset",
        "view": "monthly_summary",
        "time": { "column": "recorded_at", "type": "timestamp" },
        "filters": [
          { "column": "category", "operator": "equals", "value": "reporting" }
        ]
      },
      "tiles": [
        {
          "label": "Total",
          "column": "total_value",
          "reduction": "sum",
          "transform": "absolute",
          "comparison": { "direction": "higher-is-better" },
          "format": { "type": "currency" }
        },
        {
          "label": "Latest rate",
          "column": "latest_rate",
          "reduction": "latest",
          "format": { "type": "percent", "inputScale": "ratio" }
        }
      ]
    },
    {
      "id": "monthly-trend",
      "title": "Monthly trend",
      "kind": "time-series",
      "source": {
        "dataset": "sample_dataset",
        "view": "monthly_summary",
        "time": { "column": "recorded_at", "type": "timestamp" }
      },
      "window": 12,
      "variant": "area",
      "stacked": true,
      "format": { "type": "number" },
      "series": [
        { "label": "First measure", "column": "first_value", "reduction": "sum" },
        { "label": "Second measure", "column": "second_value", "reduction": "sum" }
      ]
    },
    {
      "id": "largest-entries",
      "title": "Largest entries",
      "kind": "table",
      "width": "half",
      "source": {
        "dataset": "sample_dataset",
        "view": "entries",
        "time": { "column": "recorded_at", "type": "timestamp" }
      },
      "columns": [
        { "header": "Date", "column": "occurred_on", "type": "date" },
        { "header": "Description", "column": "description", "type": "text" },
        { "header": "Amount", "column": "amount", "type": "number", "format": { "type": "currency" }, "transform": "absolute" }
      ],
      "sort": { "column": "amount", "direction": "descending" },
      "limit": 10
    },
    {
      "id": "entry-details",
      "title": "Entry details",
      "kind": "table",
      "source": {
        "dataset": "sample_dataset",
        "view": "entries",
        "time": { "column": "recorded_at", "type": "timestamp" },
        "filters": [
          { "column": "category", "operator": "not-equals", "value": "transfer" }
        ]
      },
      "columns": [
        { "header": "Date", "column": "occurred_on", "type": "date" },
        { "header": "Description", "column": "description", "type": "text" },
        { "header": "Recorded at", "column": "recorded_at", "type": "timestamp" },
        { "header": "Code", "column": "code", "type": "text", "alignment": "end" },
        { "header": "Amount", "column": "amount", "type": "number", "format": { "type": "currency" } }
      ],
      "sort": { "column": "occurred_on", "direction": "descending" },
      "paging": { "pageSize": 20 },
      "emptyMessage": "No entries in this period."
    },
    {
      "id": "category-trend",
      "title": "Monthly total by category",
      "kind": "bars",
      "source": {
        "dataset": "sample_dataset",
        "view": "entries",
        "time": {
          "column": "recorded_at",
          "type": "timestamp"
        },
        "filters": [
          {
            "column": "category",
            "operator": "not-equals",
            "value": "transfer"
          }
        ]
      },
      "x": {
        "axis": "time",
        "window": 12
      },
      "pivot": {
        "column": "category",
        "value": {
          "column": "amount",
          "reduction": "sum",
          "transform": "absolute"
        },
        "topN": {
          "count": 5,
          "otherLabel": "Other categories"
        }
      },
      "stacked": true,
      "format": {
        "type": "currency"
      }
    },
    {
      "id": "category-ranking",
      "title": "Largest categories",
      "kind": "bars",
      "width": "half",
      "source": {
        "dataset": "sample_dataset",
        "view": "entries",
        "time": {
          "column": "recorded_at",
          "type": "timestamp"
        }
      },
      "x": {
        "axis": "category",
        "column": "category",
        "by": "amount",
        "topN": {
          "count": 8,
          "otherLabel": "Other categories"
        },
        "order": "value-desc"
      },
      "series": [
        {
          "label": "Amount",
          "column": "amount",
          "reduction": "sum",
          "transform": "absolute"
        }
      ],
      "format": {
        "type": "currency"
      }
    },
    {
      "id": "weekday-totals",
      "title": "Total by weekday",
      "kind": "bars",
      "width": "half",
      "source": {
        "dataset": "sample_dataset",
        "view": "entries",
        "time": {
          "column": "recorded_at",
          "type": "timestamp"
        }
      },
      "x": {
        "axis": "category",
        "column": "weekday_name",
        "order": {
          "sortKey": {
            "column": "weekday_number",
            "type": "number"
          }
        }
      },
      "series": [
        {
          "label": "Amount",
          "column": "amount",
          "reduction": "sum",
          "transform": "absolute"
        },
        {
          "label": "Average entry",
          "column": "amount",
          "reduction": "average"
        }
      ],
      "format": {
        "type": "currency"
      }
    },
    {
      "id": "daily-trend",
      "title": "Daily trend",
      "kind": "time-series",
      "grain": "day",
      "source": {
        "dataset": "sample_dataset",
        "view": "daily_readings",
        "time": { "date": "reading_date", "hour": "reading_hour" }
      },
      "variant": "line",
      "stacked": false,
      "format": { "type": "number" },
      "series": [
        { "label": "Temperature", "column": "temperature", "reduction": "average" }
      ]
    }
  ]
}
