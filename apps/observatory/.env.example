# Logging
LOG_LEVEL=info

# Warehouse (BigQuery)
WAREHOUSE_PROJECT_ID=
WAREHOUSE_LOCATION=
# Optional: directory containing dashboard definition JSON files.
# Defaults to dashboards/ under the Observatory app directory.
OBSERVATORY_DASHBOARDS_DIR=
# Optional: service-account key path for Application Default Credentials.
# Leave unset to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
