{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run --project jsdom",
    "test:watch": "vitest watch --project jsdom",
    "test:db": "vitest run --project node-db",
    "test:all": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:up": "docker compose -f ../../docker-compose.yml -p k2bg-branding up -d postgres",
    "db:wait": "until docker exec k2bg-branding-blog-postgres pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:verify": "pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:pull && pnpm db:check && pnpm db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.750.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-openapi": "^0.19.10",
    "@hookform/resolvers": "^4.1.3",
    "@next/third-parties": "^16.2.1",
    "@notionhq/client": "^2.2.13",
    "@tanstack/react-query": "^5.70.0",
    "@tanstack/react-query-devtools": "^5.70.0",
    "cloudinary": "^2.3.1",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "handlebars": "^4.7.8",
    "hcaptcha": "^0.2.0",
    "hono": "^4.12.0",
    "motion": "^12.4.10",
    "next": "^16.2.1",
    "notion-to-md": "^3.1.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^10.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ui": "workspace:*",
    "use-debounce": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@storybook/nextjs": "^10.1.11",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^17.0.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-syntax-highlighter": "^15.5.10",
    "autoprefixer": "^10.4.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "biome-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^2.0.6",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "postcss-preset-env": "^9.1.1",
    "shiki": "^3.12.1",
    "shiki-transformer-copy-button": "^0.0.5",
    "storybook": "^10.1.11",
    "tailwind-config": "workspace:*",
    "tailwindcss": "^4.0.9",
    "test-utils": "workspace:*",
    "tsconfig": "workspace:*"
  }
}
