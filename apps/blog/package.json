{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run --project jsdom",
    "test:watch": "vitest watch --project jsdom",
    "test:db": "vitest run --project node-db",
    "test:all": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:up": "docker compose -f ../../docker-compose.yml -p k2bg-branding up -d postgres",
    "db:wait": "until docker exec k2bg-branding-blog-postgres pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done",
    "db:verify:up": "docker rm -f k2bg-branding-blog-postgres-verify >/dev/null 2>&1 || true; docker run --name k2bg-branding-blog-postgres-verify --rm -d -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=k2bg_blog -p 127.0.0.1:55432:5432 postgres:15-alpine",
    "db:verify:wait": "until docker exec k2bg-branding-blog-postgres-verify pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done",
    "db:verify:down": "docker stop k2bg-branding-blog-postgres-verify >/dev/null 2>&1 || true",
    "db:baseline": "node ./scripts/baseline-drizzle-migration.mjs",
    "db:migrate": "pnpm db:baseline && drizzle-kit migrate",
    "db:seed:admin": "tsx ./scripts/seed-admin-user.ts",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:verify": "pnpm db:verify:up && pnpm db:verify:wait && DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/k2bg_blog pnpm db:migrate && DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/k2bg_blog pnpm db:pull && DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/k2bg_blog pnpm db:check && DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/k2bg_blog pnpm db:generate; status=$?; pnpm db:verify:down; exit $status"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1109.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.10",
    "@hookform/resolvers": "^4.1.3",
    "@next/third-parties": "^16.3.0",
    "@notionhq/client": "^2.2.13",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "better-auth": "^1.6.27",
    "cloudinary": "^2.10.0",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "handlebars": "^4.7.9",
    "hcaptcha": "^0.2.0",
    "hono": "^4.13.1",
    "motion": "^12.4.10",
    "next": "^16.3.0",
    "notion-to-md": "^3.1.9",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ui": "workspace:*",
    "use-debounce": "^10.1.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@storybook/nextjs": "^10.5.7",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^17.0.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.10",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "biome-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.6",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.26",
    "postcss-preset-env": "^9.1.1",
    "shiki": "^3.12.1",
    "shiki-transformer-copy-button": "^0.0.6",
    "storybook": "^10.5.7",
    "tailwind-config": "workspace:*",
    "tailwindcss": "^4.3.3",
    "test-utils": "workspace:*",
    "tsconfig": "workspace:*",
    "tsx": "^4.23.12"
  }
}
